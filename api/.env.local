# Referência das variáveis de ambiente da api.
#
# Este arquivo NÃO é lido pela aplicação. O Spring Boot não carrega arquivos
# .env por conta própria, e o projeto não tem spring.config.import nem
# biblioteca dotenv — copiá-lo para .env não surte efeito.
#
# Ele existe para documentar os nomes e formatos. As duas variáveis abaixo já
# têm valor padrão no application.properties, então a api sobe sem nenhuma
# delas. Para sobrescrever, exporte-as como variável de ambiente de verdade
# antes de rodar:
#
#   export JWT_SECRET='...'      (Windows: $env:JWT_SECRET='...')
#   ./mvnw spring-boot:run

# Chave secreta para assinar os tokens JWT (Base64, mínimo 256 bits)
# NUNCA commit a chave de produção no repositório
JWT_SECRET=dGhpcyBpcyBhIHNhbXBsZSBzZWNyZXQga2V5IGZvciBkZXZlbG9wbWVudCB1c2Ugb25seSAtIFJFUExBQ0UgSU4gUFJPRFVDVElPTg==

# Tempo de expiração do token em milissegundos (padrão: 3600000 = 1 hora)
JWT_EXPIRATION_MS=3600000
